# ==========================================================================
# PDF Tools — variables de entorno de ejemplo
# Copia este archivo como .env.local y rellena tus propios valores.
# NUNCA subas .env.local (ni ningún archivo con secretos reales) a Git.
# ==========================================================================

# URL pública de la aplicación (cambia esto por tu dominio real en producción)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Nombre de marca (provisional, ver README para instrucciones de cómo cambiarlo)
NEXT_PUBLIC_BRAND_NAME="PDF Tools"

# --------------------------------------------------------------------------
# Stripe — usa SIEMPRE claves de TEST hasta el lanzamiento definitivo.
# Nunca expongas STRIPE_SECRET_KEY o STRIPE_WEBHOOK_SECRET al navegador ni
# las escribas en ningún archivo que subas a un repositorio público.
# Consigue tus propias claves en https://dashboard.stripe.com/test/apikeys
# --------------------------------------------------------------------------
STRIPE_SECRET_KEY=REPLACE_WITH_YOUR_STRIPE_TEST_SECRET_KEY
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=REPLACE_WITH_YOUR_STRIPE_TEST_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_YOUR_STRIPE_WEBHOOK_SIGNING_SECRET

# Price ID del plan PDF Pro (mensual). Créalo en el Dashboard de Stripe
# (Test Mode) siguiendo las instrucciones del README.
STRIPE_PRO_PRICE_ID=REPLACE_WITH_YOUR_STRIPE_PRICE_ID

# --------------------------------------------------------------------------
# Email transaccional (opcional — no se usa todavía, dejar vacío)
# --------------------------------------------------------------------------
EMAIL_FROM="PDF Tools <no-reply@example.com>"

# --------------------------------------------------------------------------
# Límites del plan gratuito / PRO (en MB y nº de operaciones/día)
# Ver src/lib/plan-limits.ts — esta es la única fuente de verdad, no
# hardcodear límites en otros archivos.
# --------------------------------------------------------------------------
FREE_MAX_FILE_SIZE_MB=15
FREE_DAILY_OPERATIONS=3
PRO_MAX_FILE_SIZE_MB=200
PRO_DAILY_OPERATIONS=1000

# --------------------------------------------------------------------------
# Publicidad (Google AdSense) — NO activar hasta tener el sitio revisado
# y aprobado. Dejar vacío desactiva automáticamente los espacios de anuncio.
# --------------------------------------------------------------------------
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# --------------------------------------------------------------------------
# Analítica (opcional, respetando el consentimiento de cookies)
# --------------------------------------------------------------------------
NEXT_PUBLIC_ANALYTICS_ID=

# --------------------------------------------------------------------------
# RESERVADAS PARA UNA FUTURA FASE 2 (cuentas de usuario)
# El MVP actual no requiere cuentas ni base de datos: el plan Pro se
# gestiona directamente con Stripe Checkout (ver src/app/api/stripe/).
# Estas variables se dejan documentadas para cuando se añada un sistema de
# cuentas (NextAuth + Prisma); no son necesarias para desplegar el MVP.
# --------------------------------------------------------------------------
# DATABASE_URL=postgresql://user:password@localhost:5432/pdftools?schema=public
# AUTH_SECRET=REPLACE_WITH_A_RANDOM_VALUE_OPENSSL_RAND_BASE64_32
# NEXTAUTH_URL=http://localhost:3000
